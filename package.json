{
  "name": "restudy",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "backend": "node scripts/python.mjs -m uvicorn backend.main:app --host 127.0.0.1 --port 8000 --reload",
    "build": "node scripts/pdf-assets.mjs && tsc --noEmit && vite build",
    "start": "vite preview --host 127.0.0.1 --port 3000 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write components lib src main.tsx vite.config.ts vitest.config.ts frontend.css app/globals.css",
    "test:legacy": "node scripts/python.mjs -m pytest backend/tests -q --basetemp=test-results/legacy-pytest"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.65.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "7.0.0",
    "vite": "^8.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "deno": "2.9.6",
    "prettier": "^3.9.10",
    "supabase": "2.122.0",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  },
  "type": "module"
}
